<project xmlns="http://maven.apache.org/POM/4.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		https://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.treasureboat</groupId>
		<artifactId>super-deploy-pom</artifactId>
		<version>0.11</version>
	</parent>

	<artifactId>super-app-pom</artifactId>
	<version>14.0</version>

	<packaging>pom</packaging>

	<name>TreasureBoat.org Maven Super App POM</name>
	<description>Parent POM for TreasureBoat applications. Extends SuperDeployPOM with application-specific configurations.</description>

	<properties>
		<!-- JDK target for all TB applications (super-app-pom 14.x = Java 14) -->
		<maven.compiler.source>14</maven.compiler.source>
		<maven.compiler.target>14</maven.compiler.target>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.treasureboat</groupId>
				<artifactId>tb-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>resource-copy</id>
						<configuration>
							<!-- Applications need TBBundlePackageType=APPL in Info.plist -->
							<isApplication>true</isApplication>
						</configuration>
					</execution>

					<!--
                        mvn tb:legacy-build
                        mvn tb:legacy-build -DprincipalClass=com.example.Application
                    -->
					<!--
					<execution>
						<id>legacy-build</id>
						<phase>package</phase>
						<goals>
							<goal>legacy-build</goal>
						</goals>
						<configuration>
							<principalClass>${principalClass}</principalClass>
						</configuration>
					</execution>
					-->
					<!--
                         mvn tb:wsr-build
                    -->
					<!--
					<execution>
						<id>wsr-build</id>
						<phase>package</phase>
						<goals>
							<goal>wsr-build</goal>
						</goals>
					</execution>
					-->
				</executions>
			</plugin>
		</plugins>
	</build>

</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		https://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.treasureboat</groupId>
		<artifactId>super-deploy-pom</artifactId>
		<version>0.3</version>
	</parent>

	<groupId>org.treasureboat</groupId>
	<artifactId>super-app-pom</artifactId>
	<version>0.1</version>

	<packaging>pom</packaging>

	<name>TreasureBoat.org Maven Super App POM</name>
	<description>Parent POM for TreasureBoat applications. Extends SuperDeployPOM with application-specific configurations.</description>

	<build>
		<plugins>
			<plugin>
				<groupId>org.treasureboat</groupId>
				<artifactId>tb-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>resource-copy</id>
						<configuration>
							<!-- Applications need TBBundlePackageType=APPL in Info.plist -->
							<isApplication>true</isApplication>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>

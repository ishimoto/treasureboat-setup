[Unit]
Description=TreasureBoat Task Daemon (tbtaskd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appserver
Group=appserveradm
WorkingDirectory=/opt/TreasureBoat/Applications

# The MEB bundle launches via run.sh (exec java -cp Contents:lib/* … Application "$@").
# AppTBTaskd.woa is a symlink -> the timestamped AppTBTaskd_embedded_*.woa (see INSTALL.md);
# to upgrade: unpack the new bundle, re-point the symlink, `systemctl restart tbtaskd`.
# Heap/JVM opts via JAVA_OPTS (Environment=JAVA_OPTS=-Xmx512m).
# systemd runs ExecStart directly (no shell), so shell redirection like '>> file' is NOT allowed here.
ExecStart=/opt/TreasureBoat/Applications/AppTBTaskd.woa/run.sh -n tbtaskd -p 1085 -newPath -url

# stdout/stderr -> a log file. (You can also just use journald: `journalctl -u tbtaskd -f`.)
StandardOutput=append:/opt/TreasureBoat/Logs/tbtaskd.log
StandardError=append:/opt/TreasureBoat/Logs/tbtaskd.log

Restart=on-failure
RestartSec=5

# A clean stop via `systemctl stop` sends SIGTERM; the JVM exits 143 (128+15) — treat as success.
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="UTF-8"?>
<project 	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
            xmlns="http://maven.apache.org/POM/4.0.0"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.treasureboat</groupId>
		<artifactId>super-app-pom</artifactId>
		<version>17.0.1</version>
		<relativePath/>
	</parent>

	<artifactId>app-deploy-taskd</artifactId>
	<version>17.0</version>

	<packaging>jar</packaging>

	<name>AppTBTaskd</name>

	<properties>
		<tb.lastmodified>2025/09/26</tb.lastmodified>
		<principalClass>org.treasureboat.app.tbtaskd.Application</principalClass>

		<!-- App-specific framework versions -->
		<tb.fw.content>17.0.1</tb.fw.content>
		<tb.fw.core>17.0.1</tb.fw.core>
		<tb.fw.db>17.0.1</tb.fw.db>
		<tb.fw.inout>17.0.2</tb.fw.inout>
		<tb.fw.archive>17.0.1</tb.fw.archive>
		<tb.fw.features>17.0.1</tb.fw.features>
		<tb.fw.extra>17.0.2</tb.fw.extra>
		<tb.fw.sangria>17.0.1</tb.fw.sangria>
		<tb.fw.pro>17.0.1</tb.fw.pro>
		<tb.fw.prox>17.0.1</tb.fw.prox>
		<tb.fw.proy>17.0.1</tb.fw.proy>
		<tb.fw.elastic>17.0.1</tb.fw.elastic>
		<tb.fw.opensearch>17.0.1</tb.fw.opensearch>
		<tb.fw.ultra>17.0.1</tb.fw.ultra>

		<tb.showDependencies>false</tb.showDependencies>

		<!-- Modules -->
		<name.module>${project.name}</name.module>
	</properties>

	<profiles>
		<!-- Build against the *.99.99-SNAPSHOT frameworks: mvn -Psnapshot ...
		     taskd only consumes tb.fw.core + tb.fw.extra today, but the full set is
		     flipped to match the sibling apps (harmless for unused ones). -->
		<profile>
			<id>snapshot</id>
			<properties>
				<tb.fw.content>${tb.java17.snapshot}</tb.fw.content>
				<tb.fw.core>${tb.java17.snapshot}</tb.fw.core>
				<tb.fw.db>${tb.java17.snapshot}</tb.fw.db>
				<tb.fw.inout>${tb.java17.snapshot}</tb.fw.inout>
				<tb.fw.archive>${tb.java17.snapshot}</tb.fw.archive>
				<tb.fw.features>${tb.java17.snapshot}</tb.fw.features>
				<tb.fw.extra>${tb.java17.snapshot}</tb.fw.extra>
				<tb.fw.sangria>${tb.java17.snapshot}</tb.fw.sangria>
				<tb.fw.pro>${tb.java17.snapshot}</tb.fw.pro>
				<tb.fw.prox>${tb.java17.snapshot}</tb.fw.prox>
				<tb.fw.proy>${tb.java17.snapshot}</tb.fw.proy>
				<tb.fw.elastic>${tb.java17.snapshot}</tb.fw.elastic>
				<tb.fw.opensearch>${tb.java17.snapshot}</tb.fw.opensearch>
				<tb.fw.ultra>${tb.java17.snapshot}</tb.fw.ultra>
			</properties>
		</profile>
	</profiles>

	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${tb.lombok}</version>
			<scope>provided</scope>
		</dependency>

		<!-- SSH stack (mina-core / sshd-core / sshd-pam) removed 2026-07-09 — embedded SSH server deleted; file upload is IntelliJ auto-deploy (SFTP). -->

		<dependency>
			<groupId>org.treasureboat</groupId>
			<artifactId>tb-core-foundation</artifactId>
			<version>${tb.fw.core}</version>
		</dependency>
		<dependency>
			<groupId>org.treasureboat</groupId>
			<artifactId>tb-core-extensions</artifactId>
			<version>${tb.fw.core}</version>
		</dependency>
		<!-- tb-features-rest removed 2026-07-09 — only the (now /oldsrc) REST controllers used it. -->
		<dependency>
			<groupId>org.treasureboat</groupId>
			<artifactId>tb-extra-monitor</artifactId>
			<version>${tb.fw.extra}</version>
		</dependency>
	</dependencies>
</project>
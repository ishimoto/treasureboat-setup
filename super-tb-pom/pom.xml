<project 	xmlns="http://maven.apache.org/POM/4.0.0"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         	https://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.treasureboat</groupId>
		<artifactId>super-deploy-pom</artifactId>
		<version>21.0.22</version>
	</parent>

	<name>TreasureBoat.org Maven Super POM</name>
	<artifactId>super-tb-pom</artifactId>
    <!-- status code: 422, reason phrase: Unprocessable Entity (422) Look's like the artifactId has to be all lowercase -->

	<packaging>pom</packaging>
	<url>https://treasureboat.org</url>

	<!--
        • Go to GitHub Settings > Developer settings > Personal access tokens
        • Create a token with these scopes:
        • write:packages (to publish packages)
        • read:packages (to download packages)
        • repo (if the repository is private)
    -->

	<!--
        • Go to GitHub Settings > Developer settings > Personal access tokens
        • Create a token with these scopes:
        • read:packages (to download packages)
    -->

	<properties>
		<tb.lastmodified>2026/10/31</tb.lastmodified>

		<!-- The version table (tb.fw.* pins, library versions, the snapshot profile and dependencyManagement)
		     lives in super-deploy-pom since 21.0.22, so applications inherit it through super-app-pom too. -->
	</properties>

    <profiles>
	    <profile>
	        <id>deploy</id>
			<properties>
				<!-- ... -->
			</properties>
		</profile>
	</profiles>

	<dependencies>
		<!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
		<dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${tb.lombok}</version>
 			<scope>provided</scope>
        </dependency>
 		<!-- https://mvnrepository.com/artifact/org.slf4j/slf4j-api -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${tb.slf4j-api}</version>
		</dependency>
	</dependencies>


	<build>
		<!-- Override source directories for TreasureBoat frameworks -->
		<sourceDirectory>src/main/java</sourceDirectory>
		<testSourceDirectory>src/test/java</testSourceDirectory>
		<!-- tb-maven-plugin configuration inherited from SuperDeployPOM -->

		<pluginManagement>
			<plugins>
				<!-- Configure the exec plugin to no-op on framework modules (no Application class).
				     This allows frameworks to be included in workspace aggregators without
				     failing when running 'mvn exec:exec' from the workspace root. -->
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>3.6.0</version>
					<configuration>
						<!-- Use the 'true' command which exits immediately with success -->
						<executable>true</executable>
						<arguments/>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
			</plugin>

			<!--
				Announce a framework release to Discord after a successful deploy.

				Declared HERE and not in SuperDeployPOM on purpose: SuperDeployPOM is also the parent of
				SuperAppPOM, and only frameworks are deployed. Keeping it on the framework parent means an
				application can never inherit it, rather than relying on the mojo's isApplication guard.

				Ordering is safe: SuperDeployPOM declares maven-deploy-plugin in <build><plugins>, and a
				parent's plugins run before a child's within the same phase — so the upload always happens
				before the announcement. That matters because GitHub Packages answers 409 for a version that
				already exists, and we must not announce a release that then fails to publish.

				The webhook URL is a credential and never lives in a POM — it comes from the <server> with id
				'tb-discord-releases' in ~/.m2/settings.xml. With no such server, the goal logs a warning and
				skips; it can never fail the build. -SNAPSHOT versions are skipped too.
			-->
			<plugin>
				<groupId>org.treasureboat</groupId>
				<artifactId>tb-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>announce-release</id>
						<phase>deploy</phase>
						<goals>
							<goal>discord-release</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<reporting>
		<plugins>
			<plugin>
				<!--
					SpotBugs - Static analysis to find bugs in Java code
					Commands:
						mvn spotbugs:check - Fail build if bugs found
						mvn spotbugs:spotbugs - Generate an XML report
						mvn spotbugs:gui - Open GUI to view bugs

					https://spotbugs.github.io/spotbugs-maven-plugin/
				-->
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.9.3.0</version>
			</plugin>
		</plugins>
	</reporting>

	<!-- Upload Information -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>ishimoto</name>
			<url>https://maven.pkg.github.com/ishimoto/treasureboat-setup</url>
		</repository>
	</distributionManagement>

</project>
